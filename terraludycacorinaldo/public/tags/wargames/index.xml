    <item>
      <title>Gradara Ludens</title>
      <link>http://localhost:1313/gradara/giochi/</link>
      <pubDate>Fri, 09 Jan 2026 00:00:00 +0000</pubDate><author>terraludycacorinaldo@gmail.com</author>
      <guid>http://localhost:1313/gradara/giochi/</guid>
      <description>&lt;p&gt;Saremo presenti a Gradara Ludens 2026!&#xA;In vista della nuova stagione, vorremmo portare questi giochi:&lt;/p&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://boardgamegeek.com/boardgame/209003/commands-and-colors-medieval&#34;&gt;Commands and colors Medieval&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://boardgamegeek.com/boardgame/368552/fighting-formations-us-29th-infantry-division&#34;&gt;Fighting Formations&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://boardgamegeek.com/boardgame/19777/indonesia&#34;&gt;Indonesia&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;p&gt;Scegli un gioco:&lt;/p&gt;&#xA;&#xA;&#xA;&lt;div class=&#34;signup-container&#34;&gt;&#xA;    &lt;h3&gt;Iscriviti&lt;/h3&gt;&#xA;&#xA;    &lt;form id=&#34;signupForm-1788375498&#34; onsubmit=&#34;handleSubmit(event, &#39;1788375498&#39;)&#34;&gt;&#xA;        &lt;div class=&#34;form-group&#34;&gt;&#xA;            &lt;label for=&#34;gameSelect-1788375498&#34;&gt;Gioco:&lt;/label&gt;&#xA;            &lt;select id=&#34;gameSelect-1788375498&#34; name=&#34;game&#34; required&gt;&#xA;                &lt;option value=&#34;&#34;&gt;-- Scegli un gioco --&lt;/option&gt;&#xA;                &lt;option value=&#34;cc&#34;&gt;Commands and Colors Medieval&lt;/option&gt;&#xA;                &lt;option value=&#34;ff&#34;&gt;Fighting Formations&lt;/option&gt;&#xA;                &lt;option value=&#34;in&#34;&gt;Indonesia&lt;/option&gt;&#xA;            &lt;/select&gt;&#xA;        &lt;/div&gt;&#xA;&#xA;        &lt;div class=&#34;form-group&#34;&gt;&#xA;            &lt;label for=&#34;nameInput-1788375498&#34;&gt;Nome/Nickname:&lt;/label&gt;&#xA;            &lt;input &#xA;                type=&#34;text&#34; &#xA;                id=&#34;nameInput-1788375498&#34; &#xA;                name=&#34;name&#34; &#xA;                placeholder=&#34;Inserisci il tuo nome&#34;&#xA;                required&#xA;            /&gt;&#xA;        &lt;/div&gt;&#xA;&#xA;        &lt;div class=&#34;form-group&#34;&gt;&#xA;            &lt;button type=&#34;submit&#34; id=&#34;submitBtn-1788375498&#34;&gt;Iscriviti&lt;/button&gt;&#xA;            &lt;div class=&#34;status-message&#34; id=&#34;statusMsg-1788375498&#34;&gt;&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/form&gt;&#xA;&#xA;    &lt;div class=&#34;registrations-section&#34;&gt;&#xA;        &lt;h4&gt;Iscritti:&lt;/h4&gt;&#xA;        &lt;div id=&#34;registrationsList-1788375498&#34;&gt;&lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;script&gt;&#xA;    const gameNames = {&#xA;        &#39;cc&#39;: &#39;Commands and Colors Medieval&#39;,&#xA;        &#39;ff&#39;: &#39;Fighting Formations&#39;,&#xA;        &#39;in&#39;: &#39;Indonesia&#39;&#xA;    };&#xA;&#xA;    async function handleSubmit(event, id) {&#xA;        event.preventDefault();&#xA;&#xA;        const gameSelect = document.getElementById(`gameSelect-${id}`);&#xA;        const nameInput = document.getElementById(`nameInput-${id}`);&#xA;        const submitBtn = document.getElementById(`submitBtn-${id}`);&#xA;        const statusMsg = document.getElementById(`statusMsg-${id}`);&#xA;        &#xA;        const game = gameSelect.value;&#xA;        const name = nameInput.value.trim();&#xA;&#xA;        if (!game || !name) {&#xA;            showStatus(statusMsg, &#39;Compila tutti i campi!&#39;, &#39;error&#39;);&#xA;            return;&#xA;        }&#xA;&#xA;        const registration = {&#xA;            game: game,&#xA;            name: name,&#xA;            timestamp: new Date().toISOString()&#xA;        };&#xA;&#xA;        submitBtn.disabled = true;&#xA;        submitBtn.textContent = &#39;Salvataggio...&#39;;&#xA;&#xA;        try {&#xA;            const response = await fetch(&#39;/api/signup&#39;, {&#xA;                method: &#39;POST&#39;,&#xA;                headers: {&#xA;                    &#39;Content-Type&#39;: &#39;application/json&#39;,&#xA;                },&#xA;                body: JSON.stringify(registration)&#xA;            });&#xA;&#xA;            if (!response.ok) {&#xA;                throw new Error(`HTTP error! status: ${response.status}`);&#xA;            }&#xA;&#xA;            showStatus(statusMsg, &#39;Iscritto con successo!&#39;, &#39;success&#39;);&#xA;            gameSelect.value = &#39;&#39;;&#xA;            nameInput.value = &#39;&#39;;&#xA;            &#xA;            setTimeout(() =&gt; {&#xA;                loadAndRenderRegistrations(id);&#xA;            }, 500);&#xA;&#xA;        } catch (error) {&#xA;            console.error(&#39;Errore:&#39;, error);&#xA;            showStatus(statusMsg, &#39;Errore nel salvataggio. Riprova.&#39;, &#39;error&#39;);&#xA;        } finally {&#xA;            submitBtn.disabled = false;&#xA;            submitBtn.textContent = &#39;Iscriviti&#39;;&#xA;            nameInput.focus();&#xA;        }&#xA;    }&#xA;&#xA;    async function loadAndRenderRegistrations(id) {&#xA;        try {&#xA;            const response = await fetch(&#39;/api/signups&#39;);&#xA;            if (!response.ok) {&#xA;                throw new Error(`HTTP error! status: ${response.status}`);&#xA;            }&#xA;            &#xA;            const registrations = await response.json();&#xA;            renderRegistrations(id, registrations);&#xA;        } catch (error) {&#xA;            console.error(&#39;Errore nel caricamento:&#39;, error);&#xA;            renderRegistrations(id, []);&#xA;        }&#xA;    }&#xA;&#xA;    function renderRegistrations(id, registrations) {&#xA;        const container = document.getElementById(`registrationsList-${id}`);&#xA;&#xA;        if (!registrations || registrations.length === 0) {&#xA;            container.innerHTML = &#39;&lt;div class=&#34;empty-registrations&#34;&gt;Nessuna iscrizione ancora&lt;/div&gt;&#39;;&#xA;            return;&#xA;        }&#xA;&#xA;        container.innerHTML = registrations.map((reg, index) =&gt; `&#xA;            &lt;div class=&#34;registration-item&#34;&gt;&#xA;                &lt;div class=&#34;registration-info&#34;&gt;&#xA;                    &lt;div class=&#34;registration-name&#34;&gt;${escapeHtml(reg.name)}&lt;/div&gt;&#xA;                    &lt;div class=&#34;registration-game&#34;&gt;${gameNames[reg.game] || reg.game}&lt;/div&gt;&#xA;                &lt;/div&gt;&#xA;                &lt;button class=&#34;registration-delete&#34; onclick=&#34;deleteRegistration(&#39;${id}&#39;, &#39;${reg.id || index}&#39;)&#34;&gt;Elimina&lt;/button&gt;&#xA;            &lt;/div&gt;&#xA;        `).join(&#39;&#39;);&#xA;    }&#xA;&#xA;    async function deleteRegistration(id, registrationId) {&#xA;        if (!confirm(&#39;Elimina questa iscrizione?&#39;)) {&#xA;            return;&#xA;        }&#xA;&#xA;        try {&#xA;            const response = await fetch(`/api/signup/${registrationId}`, {&#xA;                method: &#39;DELETE&#39;&#xA;            });&#xA;&#xA;            if (!response.ok) {&#xA;                throw new Error(`HTTP error! status: ${response.status}`);&#xA;            }&#xA;&#xA;            loadAndRenderRegistrations(id);&#xA;        } catch (error) {&#xA;            console.error(&#39;Errore nell\&#39;eliminazione:&#39;, error);&#xA;            alert(&#39;Errore nell\&#39;eliminazione&#39;);&#xA;        }&#xA;    }&#xA;&#xA;    function showStatus(element, message, type) {&#xA;        element.textContent = message;&#xA;        element.className = `status-message ${type}`;&#xA;        setTimeout(() =&gt; {&#xA;            element.className = &#39;status-message&#39;;&#xA;        }, 3000);&#xA;    }&#xA;&#xA;    function escapeHtml(text) {&#xA;        const map = {&#xA;            &#39;&amp;&#39;: &#39;&amp;amp;&#39;,&#xA;            &#39;&lt;&#39;: &#39;&amp;lt;&#39;,&#xA;            &#39;&gt;&#39;: &#39;&amp;gt;&#39;,&#xA;            &#39;&#34;&#39;: &#39;&amp;quot;&#39;,&#xA;            &#34;&#39;&#34;: &#39;&amp;#039;&#39;&#xA;        };&#xA;        return text.replace(/[&amp;&lt;&gt;&#34;&#39;]/g, m =&gt; map[m]);&#xA;    }&#xA;&#xA;    document.addEventListener(&#39;DOMContentLoaded&#39;, function() {&#xA;        loadAndRenderRegistrations(&#39;1788375498&#39;);&#xA;    });&#xA;&lt;/script&gt;</description>
    </item>
